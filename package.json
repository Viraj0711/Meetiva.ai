{
  "name": "meetiva-ai",
  "version": "1.0.0",
  "description": "AI-powered meeting intelligence platform",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "npx concurrently -n frontend,backend -c cyan,green \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/Meetiva.ai_pvt"
  },
  "keywords": [
    "meeting",
    "ai",
    "transcription",
    "action-items",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "eslint@10.7.0": true
  }
}
