{
  "name": "meetiva-ai",
  "version": "1.0.0",
  "description": "AI-powered meeting intelligence platform",
  "private": true,
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "npx concurrently -n frontend,backend -c cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:shared": "cd shared && npx tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npx tsc",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "start": "npx pm2 start ecosystem.config.cjs",
    "stop": "npx pm2 stop ecosystem.config.cjs",
    "restart": "npx pm2 restart ecosystem.config.cjs",
    "prod": "npm run build && npm run start",
    "prod:status": "npx pm2 status",
    "prod:logs": "npx pm2 logs meetiva-backend",
    "prod:shutdown": "npx pm2 delete meetiva-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "pm2": "^7.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://https://github.com/Viraj0711/Meetiva.ai"
  },
  "keywords": [
    "meeting",
    "ai",
    "transcription",
    "action-items",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "eslint@10.7.0": true
  }
}
