# Application
NODE_ENV=development
PORT=8000

# Database (MongoDB)
# Local:    MONGODB_URI=mongodb://localhost:27017/meetiva
# Atlas:    MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/meetiva?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/meetiva

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# NOTE: The actual access token expiry (15m) is hardcoded in
# backend/src/routes/auth.ts (ACCESS_TOKEN_EXPIRY constant).
# JWT_EXPIRES_IN is kept here for documentation purposes only.
JWT_EXPIRES_IN=15m

# Redis (Optional — enables shared rate-limiting across multiple server instances)
# When not set, rate limits are tracked per-process (in-memory).
REDIS_URL=redis://localhost:6379/0

# CORS
# Comma-separated list of allowed origins. Localhost patterns (localhost, 127.0.0.1,
# [::1], 192.168.x.x, 10.x.x.x) are always allowed automatically.
# All other origins NOT in this list are denied with an error.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
FRONTEND_APP_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=524288000
UPLOAD_DIR=./uploads

# AI Features (Optional)
# Groq Whisper + LLM — free tier at https://console.groq.com/keys
GROQ_API_KEY=

# Groq LLM Model — options: llama-3.3-70b-versatile (best), llama-3.1-8b-instant (fastest)
LLM_MODEL=llama-3.3-70b-versatile

# Google OAuth + Calendar (Required for calendar integration)
# Scopes requested by backend:
# - https://www.googleapis.com/auth/calendar.events
# - https://www.googleapis.com/auth/userinfo.profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# 32-byte key for AES-256-GCM token encryption.
# Use one of: 64-char hex, 32-byte raw string, or base64 of 32 bytes.
# Example generation (PowerShell):
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Admin (Optional — email that can upgrade itself to PRO via POST /auth/admin/set-tier)
# Set this to the email you registered with, then call the endpoint to enable team features.
ADMIN_EMAIL=

# Email notifications (Optional but required for email deadline alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
