# Application
NODE_ENV=development
PORT=8000

# Database (Supabase)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# File Upload
MAX_FILE_SIZE=524288000
UPLOAD_DIR=./uploads

# AI Features (Optional)
# ── Groq (Whisper transcription + LLM analysis) ────────────────────────────
# Free tier at https://console.groq.com/keys
GROQ_API_KEY=

# Whisper Transcription API key (separate from GROQ_API_KEY — use if your Groq
# org has Whisper models blocked). Supports Groq or any OpenAI-compatible provider.
WHISPER_API_KEY=

# Groq LLM Model — options: llama-3.3-70b-versatile (best), llama-3.1-8b-instant (fastest)
LLM_MODEL=llama-3.3-70b-versatile

# Groq LLM fetch timeout in milliseconds (default: 60000)
GROQ_FETCH_TIMEOUT_MS=60000

# ── xAI / Grok (alternative LLM analysis provider) ─────────────────────────
# Fallback when GROQ_API_KEY is unavailable. GROK_API_KEY takes priority
# over XAI_API_KEY (the code checks GROK_API_KEY || XAI_API_KEY).
GROK_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
