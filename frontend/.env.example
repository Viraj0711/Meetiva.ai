# API base URL — use a relative path so requests go through the Vite dev proxy
# and appear same-origin to the browser (required for httpOnly cookies to work).
# In production, the relative URL works because the backend serves the frontend build.
# Set an absolute URL (e.g. https://api.example.com/api/v1) only when deploying
# to separate domains.
VITE_API_BASE_URL=/api/v1
